# Copy to .env.local for local dev (never commit .env.local).
# In production these MUST be set in Netlify dashboard, not the repo.

# LiveKit — server-side only. NEVER prefix these with VITE_ or import.meta.env
# will bake them into the browser bundle.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public LiveKit URL — safe to expose to the browser. Vite will only inline
# variables prefixed with VITE_.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Total monthly participant-minutes your LiveKit plan provides. This whole pool
# is divided among the top-100 launchpad hosts by their MIDGARD-LP share, so each
# host sees "X min left this month". Set it to your plan's actual minutes.
# Defaults to 1000 if unset.
VITE_LIVE_POOL_MINUTES=1000

# Privy — social login (Google/X/email) → self-custodial embedded wallet.
# Frontend-safe (like an anon key). Whitelist your domain in the Privy dashboard.
# Leave unset to fall back to the Reown social flow.
VITE_PRIVY_APP_ID=your_privy_app_id

# Web push (VAPID) — public key only. Generate a pair with:
#   node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();const u=b=>b.toString('base64url');console.log(u(e.getPublicKey()),u(e.getPrivateKey()))"
# Public → here; private → the push-fanout edge function secret VAPID_PRIVATE_KEY.
VITE_VAPID_PUBLIC_KEY=

# MidChat / Supabase — frontend-safe (anon key is public; RLS guards data).
# Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# OpenRouter key is NOT a VITE_ var — it lives as a Supabase Edge Function
# secret (OPENROUTER_API_KEY), never in the browser bundle.
